#include <iostream>
using namespace std;

#define MAX 5

int stack[MAX];
int top = -1;

// Push an order number into the stack
void push(int orderNo)
{
    if (top == MAX - 1)
    {
        cout << "Stack Overflow!" << endl;
    }
    else
    {
        top++;
        stack[top] = orderNo;
    }
}

// Pop and display the cancelled order
void pop()
{
    if (top == -1)
    {
        cout << "Stack Underflow!" << endl;
    }
    else
    {
        cout << stack[top] << " ";
        top--;
    }
}

int main()
{
    int orderNo;

    cout << "Enter 5 cancelled order numbers:" << endl;

    for (int i = 0; i < MAX; i++)
    {
        cin >> orderNo;
        push(orderNo);
    }

    cout << "\nCancelled orders from most recently cancelled:\n";

    while (top != -1)
    {
        pop();
    }

    return 0;
}
