#include <iostream>
using namespace std;

int main()
{
   int student[5];
   int searchRoll;

   cout << "Enter 5 Roll numbers;\n";

   for (int i = 0; i < 5; i++)
   {
       cin >> student[i]; 
   }

   cout << "Enter the Roll Number to Search; ";
   cin >> searchRoll;

   for (int i = 0; i < 5; i++)
   {
      if (student[i] == searchRoll)
      {
          cout << "student Found";
          return 0;
      }
   }

   cout << "Student not Found";

   return 0;
}

